# Adaptive Fitness Coach — configuration surface.
# Copy to .env and fill in. Never commit .env; it is git-ignored.

APP_NAME="Adaptive Fitness Coach"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# Production runs on Supabase PostgreSQL. The password is shown once when the
# project is created and is available from Project Settings → Database.
# Use the connection pooler host for a deployed app; the direct host is fine
# for migrations and one-off tasks.
DB_CONNECTION=pgsql
DB_HOST=db.<project-ref>.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

# The automated test suite runs against an in-memory SQLite database for speed
# (see phpunit.xml). Constraint and concurrency suites require PostgreSQL —
# see docs/testing.md for why SQLite is not sufficient for those.

# --- Front end and CORS -------------------------------------------------
# The front end runs on Vercel; this API runs on Laravel Cloud. Putting both
# under one registrable domain is what keeps the session cookie same-site:
#
#   https://example.com       -> Next.js on Vercel
#   https://api.example.com   -> this API on Laravel Cloud
#
FRONTEND_URL=http://localhost:3000
# Comma-separated allowlist. Never '*': browsers refuse to send credentials to
# a wildcard origin, so it breaks authentication as well as being unsafe.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional regex list for Vercel preview deployments, e.g.
# ^https://fitnesstracker-[a-z0-9-]+\.vercel\.app$
# Leave empty in production.
CORS_ALLOWED_ORIGIN_PATTERNS=

# --- Authentication -----------------------------------------------------
AUTH_GUARD=sanctum
# Hosts whose requests are treated as first-party and served with a session
# cookie. Everything else authenticates with a bearer token.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000
SESSION_DRIVER=database
SESSION_LIFETIME=120
# In production: the leading dot shares the cookie across the apex and the api
# subdomain, which is what makes this same-site rather than cross-site.
#   SESSION_DOMAIN=.example.com
#   SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# --- Queue and cache ----------------------------------------------------
# Workout analysis runs off the request path on the database queue driver.
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail ---------------------------------------------------------------
# Password reset and email verification need a real transport in production.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object storage (Milestone 4: progress photos) ----------------------
# Supabase Storage speaks S3. The bucket must be private; photos are served
# only through an authorization check or a short-lived signed URL.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BUCKET=
AWS_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true
