# Adaptive Fitness Coach — configuration surface.
# Copy to .env and fill in. Never commit .env; it is git-ignored.

APP_NAME="Adaptive Fitness Coach"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# Production runs on Supabase PostgreSQL. The password is shown once when the
# project is created and is available from Project Settings → Database.
# Use the connection pooler host for a deployed app; the direct host is fine
# for migrations and one-off tasks.
DB_CONNECTION=pgsql
DB_HOST=db.<project-ref>.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

# The automated test suite runs against an in-memory SQLite database for speed
# (see phpunit.xml). Constraint and concurrency suites require PostgreSQL —
# see docs/testing.md for why SQLite is not sufficient for those.

# --- Authentication -----------------------------------------------------
AUTH_GUARD=sanctum
# Domains whose requests are treated as first-party and served with a session
# cookie. Everything else authenticates with a bearer token.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# --- Queue and cache ----------------------------------------------------
# Workout analysis runs off the request path on the database queue driver.
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail ---------------------------------------------------------------
# Password reset and email verification need a real transport in production.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object storage (Milestone 4: progress photos) ----------------------
# Supabase Storage speaks S3. The bucket must be private; photos are served
# only through an authorization check or a short-lived signed URL.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BUCKET=
AWS_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true
